<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "programs": the iqal-programs build
     artifact (a zip); every program in it gets an Authenticode signature. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="*.exe" min-matches="5" max-matches="5" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
