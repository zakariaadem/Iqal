[Unit]
Description=Al-Dir website and app blocker
After=local-fs.target
# Never give up restarting: a blocker that stays down is no blocker.
StartLimitIntervalSec=0

[Service]
Type=notify
ExecStart=@LIBDIR@/al-dir-daemon
Restart=always
RestartSec=1
WatchdogSec=30
RuntimeDirectory=al-dir
RuntimeDirectoryMode=0755
StateDirectory=al-dir
StateDirectoryMode=0700
# Keep the service alive under memory pressure.
OOMScoreAdjust=-900

[Install]
WantedBy=multi-user.target
