#!/bin/sh
# Iqal: after removing.
set -e

case "$1" in
    remove)
        systemctl daemon-reload || true
        ;;
    purge)
        # Settings, statistics and downloaded lists.
        chattr -R -i /var/lib/iqal /etc/.iqal-keep.json 2>/dev/null || true
        rm -rf /var/lib/iqal /etc/.iqal-keep.json
        systemctl daemon-reload || true
        ;;
esac

exit 0
