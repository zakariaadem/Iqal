#!/bin/sh
# Iqal: after installing or upgrading.
set -e

if [ "$1" = "configure" ]; then
    systemctl daemon-reload || true
    systemctl enable iqal.service >/dev/null 2>&1 || true
    # Start, or pick up the new version after an upgrade.
    systemctl restart iqal.service || true
    gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null || true
    update-desktop-database -q /usr/share/applications 2>/dev/null || true
fi

exit 0
