[Unit]
Description=Iqal website and app blocker
After=local-fs.target
# Never give up restarting: a blocker that stays down is no blocker.
StartLimitIntervalSec=0

[Service]
Type=notify
ExecStart=@LIBDIR@/iqal-daemon
Restart=always
RestartSec=1
WatchdogSec=30
RuntimeDirectory=iqal
RuntimeDirectoryMode=0755
StateDirectory=iqal
StateDirectoryMode=0700
# Keep the service alive under memory pressure.
OOMScoreAdjust=-900

[Install]
WantedBy=multi-user.target
